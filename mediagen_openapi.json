{"openapi":"3.1.0","info":{"title":"Mediagen API","description":"A REST API service for media generation using ComfyUI workflows","version":"1.1"},"servers":[{"url":"/mediagen"}],"paths":{"/api/v1/workflows/":{"get":{"tags":["Workflows"],"summary":"List Workflows","description":"List all available workflow strategies that can be used for job submission.\n\nCan be filtered by `media_type` (e.g., 'image', 'video', 'audio', '3d', 'vision').","operationId":"list_workflows","parameters":[{"name":"media_type","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Media Type"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowList"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/workflows/{workflow_name}/schema":{"get":{"tags":["Workflows"],"summary":"Get Workflow Schema","description":"Get the parameter schema for a specific workflow.\n\nReturns JSON Schema describing the required and optional parameters\nfor the workflow. This schema is used by the MCP server to generate\ntool definitions for LLM tool calling.\n\nThe schema follows JSON Schema specification and includes:\n- Parameter types (string, integer, boolean, etc.)\n- Parameter descriptions\n- Required vs optional parameters\n- Default values\n- Examples\n\nExample response:\n```json\n{\n    \"workflow_name\": \"hidream\",\n    \"media_type\": \"image\",\n    \"description\": \"Text-to-image generation using HiDream model\",\n    \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n            \"prompt\": {\n                \"type\": \"string\",\n                \"description\": \"Text prompt for image generation\"\n            }\n        },\n        \"required\": [\"prompt\"]\n    }\n}\n```","operationId":"get_workflow_schema","parameters":[{"name":"workflow_name","in":"path","required":true,"schema":{"type":"string","title":"Workflow Name"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowSchema"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/workflows/{workflow_name}/jobs":{"post":{"tags":["Jobs"],"summary":"Submit Workflow Job","description":"Submit a new media generation job for a specific workflow.\n- **workflow_name**: The name of the workflow strategy to use.\n- **params**: A JSON string of workflow parameters.\n- **client_id**: Optional UUID for WebSocket progress tracking (auto-generated if not provided).\n\nAccepts optional file uploads mapped to parameters via 'file:{param_name}' fields.\nReturns a job ID for polling.","operationId":"submit_job","parameters":[{"name":"workflow_name","in":"path","required":true,"schema":{"type":"string","title":"Workflow Name"}}],"requestBody":{"content":{"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/Body_submit_job"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/jobs/{jobid}":{"get":{"tags":["Jobs"],"summary":"Get Job Status","description":"Return job status by polling ComfyUI backend.\nStatus can be: 'submitted', 'executing', 'completed', 'failed', 'not_found'","operationId":"get_job_status","parameters":[{"name":"jobid","in":"path","required":true,"schema":{"type":"string","title":"Jobid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobStatus"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/jobs/{jobid}/output":{"get":{"tags":["Jobs"],"summary":"List Job Output","description":"List downloadable files for the job, including all video/image outputs from ComfyUI output directory, with URLs and type.","operationId":"list_job_output","parameters":[{"name":"jobid","in":"path","required":true,"schema":{"type":"string","title":"Jobid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OutputList"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/jobs/{jobid}/output/{filename}":{"get":{"tags":["Jobs"],"summary":"Download Job Output","description":"Download a specific file from job output.\n\nFirst checks the local job directory for metadata files (job_info.json,\nworkflow_filled.json, etc.), then falls back to ComfyUI output directory.\n\nThis endpoint returns binary file data and should not be exposed to LLM tools.\nUse list_job_output to get download URLs instead.","operationId":"download_output","parameters":[{"name":"jobid","in":"path","required":true,"schema":{"type":"string","title":"Jobid"}},{"name":"filename","in":"path","required":true,"schema":{"type":"string","title":"Filename"}}],"responses":{"200":{"description":"File download","content":{"application/json":{"schema":{}},"image/png":{},"video/mp4":{}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-mcp-hidden":true}},"/api/v1/jobs/{jobid}/stream/{filename}":{"get":{"tags":["Jobs"],"summary":"Stream Job Video","description":"Stream a video file from ComfyUI output directory for browser playback.\nSupports range requests for proper video streaming.\n\nThis endpoint returns binary video data and should not be exposed to LLM tools.\nUse list_job_output to get stream URLs instead.","operationId":"stream_video","parameters":[{"name":"jobid","in":"path","required":true,"schema":{"type":"string","title":"Jobid"}},{"name":"filename","in":"path","required":true,"schema":{"type":"string","title":"Filename"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-mcp-hidden":true}},"/api/v1/debug/comfyui-output":{"get":{"tags":["Debug"],"summary":"Debug Comfyui Output","description":"Debug endpoint to check what's in ComfyUI's output directory.","operationId":"debug_comfyui_output","parameters":[{"name":"host","in":"query","required":false,"schema":{"type":"string","default":"localhost","title":"Host"}},{"name":"port","in":"query","required":false,"schema":{"type":"integer","default":8188,"title":"Port"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/test-websocket-loading":{"get":{"tags":["Debug"],"summary":"Test Websocket Loading","description":"Test endpoint to verify code after debug endpoint is being loaded.","operationId":"test_websocket_loading","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/v1/system/free_memory":{"post":{"tags":["System"],"summary":"Free GPU memory by unloading models","description":"Free GPU memory by calling ComfyUI's /free endpoint.\n\nArgs:\n    unload_models: Whether to unload models from GPU (default: True)\n    free_memory: Whether to free memory cache (default: True)\n\nReturns:\n    Status message","operationId":"free_gpu_memory","parameters":[{"name":"unload_models","in":"query","required":false,"schema":{"type":"boolean","default":true,"title":"Unload Models"}},{"name":"free_memory","in":"query","required":false,"schema":{"type":"boolean","default":true,"title":"Free Memory"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"Body_submit_job":{"properties":{"params":{"type":"string","title":"Params","default":"{}"},"client_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Client Id"}},"type":"object","title":"Body_submit_job"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"JobResponse":{"properties":{"jobid":{"type":"string","title":"Jobid","description":"Unique job identifier"},"comfyui_job_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Comfyui Job Id","description":"ComfyUI job identifier"},"client_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Client Id","description":"Client UUID for WebSocket progress tracking"},"status":{"type":"string","title":"Status","description":"Job status"},"message":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Message","description":"Status message"},"error":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Error","description":"Error message if failed"}},"type":"object","required":["jobid","status"],"title":"JobResponse"},"JobStatus":{"properties":{"jobid":{"type":"string","title":"Jobid","description":"Job identifier"},"comfyui_job_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Comfyui Job Id","description":"ComfyUI job identifier"},"status":{"type":"string","title":"Status","description":"Job status"},"message":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Message","description":"Status message"},"output_files":{"anyOf":[{"items":{"$ref":"#/components/schemas/OutputFile"},"type":"array"},{"type":"null"}],"title":"Output Files","description":"Output files if completed"},"error":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Error","description":"Error message if failed"}},"type":"object","required":["jobid","status"],"title":"JobStatus"},"OutputFile":{"properties":{"type":{"type":"string","title":"Type","description":"File type (video, image, meta)"},"download_url":{"type":"string","title":"Download Url","description":"Download URL (use this path for subsequent workflow inputs)"},"stream_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Stream Url","description":"Stream URL (for videos)"},"node_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Node Id","description":"ComfyUI node ID"}},"type":"object","required":["type","download_url"],"title":"OutputFile"},"OutputList":{"properties":{"jobid":{"type":"string","title":"Jobid","description":"Job identifier"},"count":{"type":"integer","title":"Count","description":"Number of output files"},"output_files":{"items":{"$ref":"#/components/schemas/OutputFile"},"type":"array","title":"Output Files","description":"List of output files"}},"type":"object","required":["jobid","count","output_files"],"title":"OutputList"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"},"WorkflowList":{"properties":{"count":{"type":"integer","title":"Count","description":"Number of available workflows"},"workflows":{"items":{"$ref":"#/components/schemas/WorkflowSummary"},"type":"array","title":"Workflows"}},"type":"object","required":["count","workflows"],"title":"WorkflowList"},"WorkflowSchema":{"properties":{"workflow_name":{"type":"string","title":"Workflow Name","description":"Workflow name"},"media_type":{"type":"string","title":"Media Type","description":"Media type (image, video)"},"description":{"type":"string","title":"Description","description":"Workflow description"},"parameters":{"additionalProperties":true,"type":"object","title":"Parameters","description":"JSON Schema describing workflow parameters"},"model_card_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Model Card Url","description":"URL to the model card with comprehensive model information (capabilities, limitations, examples, licensing)"},"credits":{"type":"integer","title":"Credits","description":"Cost in credits (1000 credits = $1 USD)","default":0},"credits_usd":{"type":"number","title":"Credits Usd","description":"Cost in USD","default":0.0}},"type":"object","required":["workflow_name","media_type","description","parameters"],"title":"WorkflowSchema"},"WorkflowSummary":{"properties":{"name":{"type":"string","title":"Name","description":"Workflow strategy name"},"media_type":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Media Type","description":"Media type (e.g., 'image', 'video')"},"description":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Description","description":"Workflow description"},"credits":{"type":"integer","title":"Credits","description":"Cost in credits (1000 credits = $1 USD)","default":0},"credits_usd":{"type":"number","title":"Credits Usd","description":"Cost in USD","default":0.0}},"type":"object","required":["name"],"title":"WorkflowSummary"}}}}